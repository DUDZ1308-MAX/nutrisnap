# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required for auth
JWT_SECRET=your-random-secret-here-change-in-production

# Required for photo analysis (Google Gemini)
GEMINI_API_KEY=

# Required for food name search (USDA FoodData Central)
# Get a free key at https://api.data.gov/signup
FDC_API_KEY=

# Optional - API Server
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional - Frontend
BASE_PATH=/
